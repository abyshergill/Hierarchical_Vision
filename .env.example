# Copy to .env and edit:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- Core ---
# set to 0 in production
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://hr.example.com
CSRF_TRUSTED_ORIGINS=
# change in production to hide the admin
ADMIN_URL=django-admin/

# --- Database (default: SQLite) ---
SQLITE_NAME=db.sqlite3
# DATABASE_URL=postgres://user:password@localhost:5432/hierarchical_vision
# DB_ENGINE=postgres
# DB_NAME=hierarchical_vision
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
# DB_SSLMODE=require

# --- Email (default prints emails to the console) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=hr@example.com

# --- Security / rate limits ---
RATE_LIMIT_PER_MINUTE=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_LOCKOUT_MINUTES=15
# 1 only behind exactly one trusted proxy
TRUST_X_FORWARDED_FOR=0
# used when DEBUG=0
SECURE_SSL_REDIRECT=1
BEHIND_PROXY=0
